{
  "name": "paper-parallel",
  "version": "0.1.0",
  "private": true,
  "description": "论文双子 Paper Parallel — 中英双语 PDF 对照阅读器(纯静态 GitHub Pages)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "npm run typecheck && npm test && npm run build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts --fix",
    "format": "prettier --write .",
    "probe:p3": "npx vite --host 127.0.0.1 probes"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
